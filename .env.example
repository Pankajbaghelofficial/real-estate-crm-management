# Copy to .env for local development. Never commit real values.

# PostgreSQL. On Vercel the Neon integration adds both automatically.
# DATABASE_URL          = pooled connection (app runtime)
# DATABASE_URL_UNPOOLED = direct connection (prisma migrate, import script)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/crm"

# NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the site. Optional on Vercel (detected automatically).
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob. When set, uploads go to Blob storage; when empty, to public/uploads on disk.
# On Vercel, connecting a Blob store to the project adds this automatically.
BLOB_READ_WRITE_TOKEN=""
