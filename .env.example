# Copy to .env for local development. Never commit real values.

# PostgreSQL. On Vercel the database integration adds these automatically.
# DATABASE_URL           = connection used by the app (Prisma Postgres: direct, Neon: pooled)
# DATABASE_URL_UNPOOLED  = Neon only: direct connection for migrations.
#                          Without it, migrations use DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm"

# NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Public URL of the site. Optional on Vercel (detected automatically).
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob. When set, uploads go to Blob storage; when empty, to public/uploads on disk.
# On Vercel, connecting a Blob store to the project adds this automatically.
BLOB_READ_WRITE_TOKEN=""

# Optional: first super admin, created during the build only while the database has no users.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
